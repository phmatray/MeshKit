# ---- Stripe ---------------------------------------------------------------------------------
# A restricted key (rk_live_… / rk_test_…) with "Checkout Sessions: write" is enough.
STRIPE__SECRETKEY=rk_test_replace_me
# Signing secret of the webhook endpoint https://<your-host>/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed)
STRIPE__WEBHOOKSECRET=whsec_replace_me
# Only for the optional `--profile dev` stripe-cli forwarder (needs a secret key, not a restricted one).
STRIPE_CLI_API_KEY=

# ---- MeshKit --------------------------------------------------------------------------------
# Scheme + host the public uses; Stripe redirects back here after checkout.
MESHKIT__PUBLICBASEURL=https://meshkit.example.com
# Bearer token the "Generate pack" workflow presents to POST /api/ingest. Leave empty to disable ingest.
# Generate one with:  openssl rand -hex 32
MESHKIT__INGEST__TOKEN=
# Host port to publish (default 8080) and image tag (default latest).
MESHKIT_PORT=8080
MESHKIT_TAG=latest

# ---- Email (transactional: purchase confirmation, password reset, address confirmation) ----
# Leave SMTP__HOST empty to disable sending (messages are logged instead).
SMTP__HOST=mail.example.com
SMTP__PORT=587
SMTP__USESTARTTLS=true
SMTP__USER=
SMTP__PASSWORD=
SMTP__FROMNAME=MeshKit by Atypical Consulting
SMTP__FROMADDRESS=
