@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject Search.ISearchService SearchService

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ink focus:px-3 focus:py-2 focus:text-cream">Skip to content</a>

<header class="border-b border-ink/10 bg-cream/90 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-6 py-4" aria-label="Main">
        <Logo />
        <SearchBox Class="order-last w-full sm:order-none sm:ml-2 sm:w-64 lg:w-80" />
        <ul class="ml-auto flex items-center gap-5 text-sm font-medium">
            <li><a href="packs" class="hover:text-coral-dark">Packs</a></li>
            <li><a href="search" class="hover:text-coral-dark">Models</a></li>
            <AuthorizeView>
                <Authorized>
                    <AuthorizeView Policy="@MeshKit.Web.Admin.MeshKitPolicies.Owner" Context="owner">
                        <li><a href="admin" class="hover:text-coral-dark">Dashboard</a></li>
                    </AuthorizeView>
                    <li><a href="library" class="hover:text-coral-dark">My library</a></li>
                    <li><a href="account" class="hover:text-coral-dark">Account</a></li>
                    <li>
                        <form action="account/logout" method="post" class="inline">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="@Navigation.ToBaseRelativePath(Navigation.Uri)" />
                            <button type="submit" class="text-ink/70 hover:text-coral-dark">Log out <span class="sr-only">(@context.User.Identity?.Name)</span></button>
                        </form>
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li><a href="account/login" class="hover:text-coral-dark">Log in</a></li>
                    <li><a href="account/register" class="rounded-full bg-ink px-4 py-2 text-cream hover:bg-ink/85">Sign up</a></li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>
    </nav>
</header>

<main id="main" class="mx-auto w-full max-w-6xl flex-1 px-6 py-10">
    @Body
</main>

<footer class="border-t border-ink/10 bg-white/40">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 py-10 text-sm text-ink/70 md:grid-cols-4">
        <div class="space-y-2">
            <Logo Size="24" />
            <p>Game-ready 3D model packs, generated with Meshy and curated by hand. Payments by Stripe.</p>
        </div>
        <nav aria-label="Browse" class="space-y-1">
            <h2 class="font-semibold text-ink">Browse</h2>
            <ul class="space-y-1">
                <li><a href="free-3d-models" class="hover:text-coral-dark">Free 3D models</a></li>
                @foreach (var c in Landing.Collections.Available(SearchService).Where(c => c.Kind != Landing.CollectionKind.Free).Take(8))
                {
                    <li><a href="@c.Path" class="hover:text-coral-dark">@c.Headline</a></li>
                }
                <li><a href="3d-models" class="hover:text-coral-dark">All collections</a></li>
            </ul>
        </nav>
        <nav aria-label="Legal" class="space-y-1">
            <h2 class="font-semibold text-ink">Legal</h2>
            <ul class="space-y-1">
                <li><a href="legal/terms" class="hover:text-coral-dark">Terms of sale</a></li>
                <li><a href="legal/privacy" class="hover:text-coral-dark">Privacy &amp; cookies</a></li>
                <li><a href="legal/licence" class="hover:text-coral-dark">Asset licence</a></li>
            </ul>
        </nav>
        <address class="not-italic">
            <h2 class="font-semibold text-ink">MeshKit by Atypical Consulting</h2>
            <p>Philippe Matray · Belgium</p>
            <p>VAT <span class="tabular-nums">BE 0744.517.956</span></p>
            <p><a href="mailto:philippe@atypical.consulting" class="hover:text-coral-dark">philippe@atypical.consulting</a></p>
        </address>
    </div>
</footer>
