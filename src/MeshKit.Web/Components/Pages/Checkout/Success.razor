@page "/checkout/success"

<PageTitle>Thank you — MeshKit</PageTitle>

<div class="mx-auto max-w-xl space-y-6 text-center">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-3xl" aria-hidden="true">✓</div>
    <h1 class="text-3xl font-bold">Thank you for your purchase</h1>
    <p class="text-ink/70">
        Your payment is being confirmed by Stripe. The pack appears in your library as soon as the confirmation
        arrives — usually within a few seconds.
    </p>
    <a href="library" class="inline-block rounded-full bg-ink px-6 py-3 font-semibold text-cream hover:bg-ink/85">Go to my library</a>
</div>
