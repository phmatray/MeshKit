@page "/error"
@using System.Diagnostics

<PageTitle>Error — MeshKit</PageTitle>

<h1 class="text-3xl font-bold text-red-700">Something went wrong</h1>
<p class="mt-4 text-ink/70">An error occurred while processing your request.</p>
@if (ShowRequestId)
{
    <p class="mt-2 text-sm text-ink/50"><strong>Request ID:</strong> <code>@RequestId</code></p>
}

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() => RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
