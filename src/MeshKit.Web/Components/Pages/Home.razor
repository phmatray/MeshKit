@page "/"
@inject ICatalogService Catalog

<PageTitle>MeshKit — 3D model packs</PageTitle>

<section class="grid items-center gap-10 py-6 md:grid-cols-2">
    <div class="space-y-6">
        <h1 class="text-4xl font-bold leading-tight tracking-tight md:text-5xl">Game-ready 3D model packs, generated and curated.</h1>
        <p class="text-lg text-ink/70">Every pack ships as GLB, FBX, OBJ and USDZ with PBR textures. Preview every model in your browser before you buy.</p>
        <a href="packs" class="inline-block rounded-full bg-coral px-6 py-3 font-semibold text-ink hover:bg-coral-dark">Browse packs</a>
    </div>
    <div class="aspect-square overflow-hidden rounded-3xl border border-ink/10 bg-white shadow-sm">
        @if (Featured is { } featured)
        {
            <model-viewer src="@CatalogEndpoints.PublicUrl(featured.Slug, featured.Preview)"
                          alt="3D preview of @featured.Name"
                          camera-controls auto-rotate shadow-intensity="1" touch-action="pan-y"></model-viewer>
        }
        else
        {
            <div class="flex h-full items-center justify-center text-ink/40">No pack published yet</div>
        }
    </div>
</section>

@if (Catalog.Sellable.Count > 0)
{
    <section class="mt-12" aria-labelledby="latest">
        <h2 id="latest" class="mb-6 text-2xl font-bold">Latest packs</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var pack in Catalog.Sellable.Take(3))
            {
                <PackCard Pack="pack" />
            }
        </div>
    </section>
}

@code {
    private (string Slug, string Name, string Preview)? Featured =>
        Catalog.Sellable.SelectMany(p => p.Models.Where(m => m.Preview is not null).Select(m => (p.Slug, m.Name, m.Preview!))).FirstOrDefault() is { Slug: not null } f ? f : null;
}
