@page "/"
@inject ICatalogService Catalog
@inject IOptions<MeshKitOptions> MeshKit
@using Microsoft.Extensions.Options

<PageTitle>MeshKit — game-ready 3D model packs</PageTitle>
<Seo Title="MeshKit — game-ready 3D model packs"
     Description="Curated packs of low-poly, PBR-textured 3D models in GLB, FBX, OBJ and USDZ. Preview every model in your browser, buy once, download forever."
     Path=""
     JsonLd="@JsonLdBuilder.Organization(MeshKit.Value.PublicBaseUrl.TrimEnd('/'))" />

<section class="grid items-center gap-10 py-6 md:grid-cols-2">
    <div class="space-y-6">
        <h1 class="text-4xl font-bold leading-tight tracking-tight md:text-5xl">Game-ready 3D model packs, generated and curated.</h1>
        <p class="text-lg text-ink/70">Every pack ships as GLB, FBX, OBJ and USDZ with PBR textures. Preview every model in your browser, and download one model per pack for free to try it in your engine before you buy.</p>
        <div class="flex flex-wrap items-center gap-4">
            <a href="packs" class="inline-block rounded-full bg-coral px-6 py-3 font-semibold text-ink hover:bg-coral-dark">Browse packs</a>
            <a href="free-3d-models" class="font-semibold underline-offset-4 hover:text-coral-dark hover:underline">Free sample models →</a>
        </div>
    </div>
    @if (Featured is { } featured)
    {
        <ModelStage Src="@CatalogEndpoints.PublicUrl(featured.Slug, featured.Preview)"
                    Poster="@(featured.Thumbnail is null ? null : CatalogEndpoints.PublicUrl(featured.Slug, featured.Thumbnail))"
                    Alt="@($"3D preview of {featured.Name}")"
                    Badge="@featured.Name" />
    }
    else
    {
        <div class="flex aspect-square items-center justify-center rounded-3xl border border-dashed border-ink/20 text-ink/40">No pack published yet</div>
    }
</section>

@if (Catalog.Sellable.Count > 0)
{
    <section class="mt-12" aria-labelledby="latest">
        <h2 id="latest" class="mb-6 text-2xl font-bold">Latest packs</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var pack in Latest.Take(3))
            {
                <PackCard Pack="pack" />
            }
        </div>
    </section>
}

@code {
    // Newest pack first: the catalogue itself is alphabetical, which put the sample pack in the hero.
    private IEnumerable<PackManifest> Latest => Catalog.Sellable.OrderByDescending(p => p.GeneratedAt);

    private (string Slug, string Name, string Preview, string? Thumbnail)? Featured =>
        Latest.SelectMany(p => p.Models.Where(m => m.Preview is not null).Select(m => (p.Slug, m.Name, m.Preview!, m.Thumbnail))).FirstOrDefault() is { Slug: not null } f ? f : null;
}
