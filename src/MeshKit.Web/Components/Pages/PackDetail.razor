@page "/packs/{Slug}"
@inject ICatalogService Catalog
@inject IEntitlementReader Entitlements
@inject IHttpContextAccessor HttpContextAccessor
@inject IOptions<MeshKitOptions> MeshKit
@using Microsoft.Extensions.Options

@if (Pack is null || !Pack.IsSellable)
{
    <PageTitle>Pack not found — MeshKit</PageTitle>
    <h1 class="text-3xl font-bold">Pack not found</h1>
    <p class="mt-4"><a href="packs" class="underline">Back to all packs</a></p>
}
else
{
    <PageTitle>@Pack.Name — MeshKit</PageTitle>
    <Seo Title="@($"{Pack.Name} — {Pack.Models.Count} 3D models")"
         Description="@Pack.Description"
         Path="@($"packs/{Pack.Slug}")"
         Type="product"
         Image="@OgImage"
         ImageAlt="@($"{Selected.Name} from {Pack.Name}")"
         JsonLd="@JsonLdBuilder.Product(MeshKit.Value.PublicBaseUrl.TrimEnd('/'), Pack, OgImage)" />

    @* Three grid cells: on phones the header (title, stats, Buy) comes first, then the viewer, then
       the contents list; from lg up the viewer spans both rows on the left and the two others stack on the right. *@
    <div class="grid gap-x-10 gap-y-8 lg:grid-cols-[1.2fr_1fr] lg:grid-rows-[auto_1fr]">
        <section aria-label="3D preview" class="space-y-4 lg:col-start-1 lg:row-span-2 lg:row-start-1">
            <ModelStage Src="@CatalogEndpoints.PublicUrl(Pack.Slug, SelectedVariant?.Preview ?? Selected.Preview!)"
                        Poster="@((SelectedVariant?.Thumbnail ?? Selected.Thumbnail) is { } poster ? CatalogEndpoints.PublicUrl(Pack.Slug, poster) : null)"
                        Alt="@($"3D preview of {Selected.Name}{(SelectedVariant is null ? "" : $" ({SelectedVariant.Name})")}")"
                        Badge="@(SelectedVariant is not null ? SelectedVariant.Name : Selected.PreviewTextured ? "Textured" : "Clay preview")" />
            @if (Selected.VariantList.Count > 0)
            {
                <ul class="flex flex-wrap items-center gap-2" aria-label="Texture variants">
                    <li class="text-sm text-ink/60">Skins:</li>
                    <li>
                        <a href="packs/@Pack.Slug?model=@Selected.Slug" class="flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-sm @(SelectedVariant is null ? "border-coral bg-coral/20 font-semibold" : "border-ink/15 bg-white hover:border-coral-dark")" aria-current="@(SelectedVariant is null ? "true" : null)">
                            @if (Selected.Thumbnail is not null)
                            {
                                <img src="@CatalogEndpoints.PublicUrl(Pack.Slug, Selected.Thumbnail)" alt="" class="h-6 w-6 rounded-full object-cover" />
                            }
                            Default
                        </a>
                    </li>
                    @foreach (var v in Selected.VariantList.Where(v => v.Preview is not null))
                    {
                        <li>
                            <a href="packs/@Pack.Slug?model=@Selected.Slug&variant=@v.Slug" class="flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-sm @(SelectedVariant?.Slug == v.Slug ? "border-coral bg-coral/20 font-semibold" : "border-ink/15 bg-white hover:border-coral-dark")" aria-current="@(SelectedVariant?.Slug == v.Slug ? "true" : null)">
                                @if (v.Thumbnail is not null)
                                {
                                    <img src="@CatalogEndpoints.PublicUrl(Pack.Slug, v.Thumbnail)" alt="" class="h-6 w-6 rounded-full object-cover" />
                                }
                                @v.Name
                            </a>
                        </li>
                    }
                </ul>
            }
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h2 class="text-lg font-semibold">@Selected.Name@(SelectedVariant is null ? "" : $" · {SelectedVariant.Name}")</h2>
                    <p class="text-sm text-ink/60">@(Selected.PreviewTextured ? $"Textured preview at reduced resolution; the download carries the full {Selected.Metadata?.TextureResolution ?? "2k"} maps." : "Untextured preview; purchased files are fully textured.") Drag to orbit, scroll to zoom.</p>
                </div>
                @if (Selected.TagList.Count > 0 || Pack.TagList.Count > 0)
                {
                    <ul class="flex flex-wrap gap-1.5" aria-label="Tags">
                        @foreach (var tag in Selected.TagList.Concat(Pack.TagList).Distinct())
                        {
                            <li><TagChip Tag="@tag" /></li>
                        }
                    </ul>
                }
            </div>
            @if (Selected.Metadata is { } meta)
            {
                <dl class="grid grid-cols-2 gap-x-6 gap-y-2 rounded-2xl border border-ink/10 bg-white px-5 py-4 text-sm sm:grid-cols-4" aria-label="Model specifications">
                    <div><dt class="text-ink/50">Triangles</dt><dd class="font-semibold tabular-nums">@Format.Count(meta.Triangles)</dd></div>
                    <div><dt class="text-ink/50">Vertices</dt><dd class="font-semibold tabular-nums">@Format.Count(meta.Vertices)</dd></div>
                    <div><dt class="text-ink/50">Size (W×H×D)</dt><dd class="font-semibold tabular-nums">@Format.Metres(meta.Width) × @Format.Metres(meta.Height) × @Format.Metres(meta.Depth)&nbsp;m</dd></div>
                    <div><dt class="text-ink/50">Textures</dt><dd class="font-semibold">@(meta.TextureMaps.Count > 0 ? $"{meta.TextureMaps.Count} maps · {meta.TextureResolution}{(meta.Pbr ? " PBR" : "")}" : "none")</dd></div>
                    @if (Selected.LodList.Count > 0)
                    {
                        <div class="col-span-2 sm:col-span-4"><dt class="text-ink/50">LODs</dt><dd class="font-semibold tabular-nums">@Format.Count(meta.Triangles) → @string.Join(" → ", Selected.LodList.Select(l => l.Triangles is { } t ? Format.Count(t) : $"≤{Format.Count(l.TargetPolycount)}")) tris <span class="font-normal text-ink/50">(lod1–lod@(Selected.LodList.Count) shipped next to the full model)</span></dd></div>
                    }
                </dl>
            }
            <ul class="grid grid-cols-4 gap-3 sm:grid-cols-6" aria-label="Models in this pack">
                @foreach (var model in Pack.Models)
                {
                    <li>
                        <a href="packs/@Pack.Slug?model=@model.Slug"
                           class="relative block aspect-square overflow-hidden rounded-xl border-2 bg-white @(model.Slug == Selected.Slug ? "border-coral" : "border-transparent hover:border-ink/30")"
                           aria-current="@(model.Slug == Selected.Slug ? "true" : null)"
                           title="@(model.Slug == Pack.Sample ? $"{model.Name} — free sample" : model.Name)">
                            @if (model.Thumbnail is not null)
                            {
                                <img src="@CatalogEndpoints.PublicUrl(Pack.Slug, model.Thumbnail)" alt="@model.Name" loading="lazy" class="h-full w-full object-cover" />
                            }
                            @if (model.Slug == Pack.Sample)
                            {
                                <span class="absolute left-1 top-1 rounded-full bg-coral px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-ink">Free</span>
                            }
                        </a>
                    </li>
                }
            </ul>
        </section>

        <section class="order-first space-y-6 lg:order-none lg:col-start-2 lg:row-start-1">
            <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-ink/50">@Pack.Category · @Pack.Style</p>
                <h1 class="text-3xl font-bold">@Pack.Name</h1>
            </div>
            <p class="text-ink/75">@Pack.Description</p>
            <dl class="grid grid-cols-2 gap-4 rounded-2xl border border-ink/10 bg-white p-5 text-sm">
                <div><dt class="text-ink/60">Models</dt><dd class="text-lg font-semibold">@Pack.Models.Count</dd></div>
                <div><dt class="text-ink/60">Formats</dt><dd class="text-lg font-semibold uppercase">@string.Join(" · ", Formats)</dd></div>
                <div><dt class="text-ink/60">Polygons</dt><dd class="text-lg font-semibold tabular-nums">@TriangleRange</dd></div>
                <div><dt class="text-ink/60">Download</dt><dd class="text-lg font-semibold">@Format.Bytes(Pack.Models.Sum(m => m.AllFiles.Sum(f => f.Bytes)))</dd></div>
                @if (LodCount > 0)
                {
                    <div class="col-span-2"><dt class="text-ink/60">Levels of detail</dt><dd class="text-lg font-semibold">Full model + @Format.Plural(LodCount, "LOD") per model</dd></div>
                }
                @if (VariantCount > 0)
                {
                    <div class="col-span-2"><dt class="text-ink/60">Texture variants</dt><dd class="text-lg font-semibold">@(VariantCount + 1) skins per model <span class="text-sm font-normal text-ink/60">(default + @string.Join(", ", Pack.Models[0].VariantList.Select(v => v.Name)))</span></dd></div>
                }
            </dl>

            @if (Owned)
            {
                <a href="library/@Pack.Slug/download" class="block rounded-full bg-ink px-6 py-3 text-center font-semibold text-cream hover:bg-ink/85">Download pack (.zip)</a>
                <p class="text-sm text-ink/60">You own this pack. It is also in <a href="library" class="underline">your library</a>.</p>
            }
            else
            {
                <form method="post" action="checkout/@Pack.Slug">
                    <AntiforgeryToken />
                    <button type="submit" class="w-full rounded-full bg-coral px-6 py-3 font-semibold text-ink hover:bg-coral-dark">
                        Buy for @Money.Format(Pack.Price.Amount, Pack.Price.Currency)
                    </button>
                </form>
                <p class="text-xs text-ink/60">
                    Secure checkout by Stripe, instant download. By buying you accept the
                    <a href="legal/terms" class="underline">terms of sale</a> and the
                    <a href="packs/@Pack.Slug/licence" class="underline">@(Pack.License?.Name ?? "asset licence")</a>,
                    and you agree to immediate delivery, which ends the 14-day withdrawal right for digital content.
                </p>
            }


            @if (Pack.SampleModel is { } sample)
            {
                <aside class="rounded-2xl border border-coral/60 bg-coral/10 p-5" aria-labelledby="sample-heading">
                    <div class="flex items-start gap-4">
                        @if (sample.Thumbnail is not null)
                        {
                            <img src="@CatalogEndpoints.PublicUrl(Pack.Slug, sample.Thumbnail)" alt="" loading="lazy" class="h-16 w-16 shrink-0 rounded-xl bg-white object-contain p-1" />
                        }
                        <div class="min-w-0 flex-1">
                            <h2 id="sample-heading" class="font-semibold">Free sample: @sample.Name</h2>
                            <p class="mt-1 text-sm text-ink/70">
                                Try before you buy — the full @sample.Name with every format and texture, under the same licence as the pack.
                                Open it in Blender or Unity and judge the topology, UVs, scale and pivot yourself.
                            </p>
                            @if (SignedIn)
                            {
                                <form method="post" action="packs/@Pack.Slug/sample" class="mt-3 space-y-2">
                                    <AntiforgeryToken />
                                    @if (MeshKit.Value.SampleFollowUp.Enabled)
                                    {
                                        <label class="flex items-start gap-2 text-sm text-ink/80">
                                            <input type="checkbox" name="followup" value="on" class="mt-0.5 accent-coral-dark" />
                                            <span>Email me a <strong>@MeshKit.Value.SampleFollowUp.DiscountLabel</strong> code for this pack in two days, once I've tried it. One email, no list.</span>
                                        </label>
                                    }
                                    <button type="submit" class="inline-block rounded-full bg-ink px-4 py-2 text-sm font-semibold text-cream hover:bg-ink/85">Download free sample (.zip)</button>
                                </form>
                            }
                            else
                            {
                                <a href="account/login?returnUrl=@Uri.EscapeDataString($"/packs/{Pack.Slug}/sample")" class="mt-3 inline-block rounded-full bg-ink px-4 py-2 text-sm font-semibold text-cream hover:bg-ink/85">Sign in to download the free sample</a>
                                <span class="ml-2 text-xs text-ink/60">Free account, no card.</span>
                            }
                        </div>
                    </div>
                </aside>
            }
        </section>

        <section aria-labelledby="inside" class="space-y-4 lg:col-start-2 lg:row-start-2">
            <h2 id="inside" class="text-lg font-semibold">What's inside</h2>
            <ul class="divide-y divide-ink/10 rounded-2xl border border-ink/10 bg-white">
                @foreach (var model in Pack.Models)
                {
                    <li class="flex items-center justify-between gap-3 px-4 py-2 text-sm">
                        <span class="flex items-center gap-2">
                            <a href="packs/@Pack.Slug?model=@model.Slug" class="hover:text-coral-dark">@model.Name</a>
                            @if (model.Slug == Pack.Sample)
                            {
                                <span class="rounded-full bg-coral px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-ink">Free</span>
                            }
                        </span>
                        <span class="text-ink/50 tabular-nums">@(model.Metadata is { } m ? $"{Format.Count(m.Triangles)} tris · " : "")@model.Files.Count(f => GenerationFormats.Contains(f.Format)) files@(model.LodList.Count > 0 ? $" · {Format.Plural(model.LodList.Count, "LOD")}" : "")@(model.VariantList.Count > 0 ? $" · {Format.Plural(model.VariantList.Count + 1, "skin")}" : "")</span>
                    </li>
                }
                @if (Pack.License is not null)
                {
                    <li class="flex items-center justify-between gap-3 px-4 py-2 text-sm text-ink/70">
                        <span>LICENSE.txt — @Pack.License.Name</span>
                        <a href="packs/@Pack.Slug/licence" class="underline hover:text-coral-dark">Read</a>
                    </li>
                }
            </ul>
        </section>
    </div>
}

@code {
    /// <summary>Mesh files that count as deliverables (texture maps are listed as files too but aren't formats).</summary>
    private static readonly HashSet<string> GenerationFormats = ["glb", "fbx", "obj", "mtl", "usdz", "stl", "3mf"];

    /// <summary>What the "Formats" stat shows: <c>mtl</c> is the OBJ material sidecar, not a format a buyer picks.</summary>
    private static readonly HashSet<string> DisplayFormats = ["glb", "fbx", "obj", "usdz", "stl", "3mf"];

    [Parameter] public required string Slug { get; set; }

    [SupplyParameterFromQuery(Name = "model")] public string? ModelSlug { get; set; }

    [SupplyParameterFromQuery(Name = "variant")] public string? VariantSlug { get; set; }

    private ModelVariant? SelectedVariant => VariantSlug is null ? null : Selected.VariantList.FirstOrDefault(v => v.Slug == VariantSlug && v.Preview is not null);

    /// <summary>Variants per model when every model has the same number, else the minimum.</summary>
    private int VariantCount => Pack!.Models.Count == 0 ? 0 : Pack.Models.Min(m => m.VariantList.Count);

    private PackManifest? Pack { get; set; }

    private ModelEntry Selected => Pack!.Models.FirstOrDefault(m => m.Slug == ModelSlug && m.Preview is not null) ?? Pack!.Models.First(m => m.Preview is not null);

    private IEnumerable<string> Formats => Pack!.Models.SelectMany(m => m.Files.Select(f => f.Format)).Where(DisplayFormats.Contains).Distinct().Order();

    /// <summary>LODs per model when every model has the same number (the normal case), else the minimum.</summary>
    private int LodCount => Pack!.Models.Count == 0 ? 0 : Pack.Models.Min(m => m.LodList.Count);

    private string TriangleRange
    {
        get
        {
            var tris = Pack!.Models.Select(m => m.Metadata?.Triangles).OfType<int>().ToList();
            return tris.Count == 0 ? "—" : tris.Min() == tris.Max() ? Format.Count(tris.Min()) : $"{Format.Count(tris.Min())}–{Format.Count(tris.Max())}";
        }
    }

    private string? OgImage => Selected.Thumbnail is null ? null : $"{MeshKit.Value.PublicBaseUrl.TrimEnd('/')}{CatalogEndpoints.PublicUrl(Pack!.Slug, Selected.Thumbnail)}";

    private bool Owned { get; set; }

    private bool SignedIn { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Pack = Catalog.Find(Slug);
        var userId = HttpContextAccessor.HttpContext?.User is { Identity.IsAuthenticated: true } user ? Entitlements.UserId(user) : null;
        SignedIn = userId is not null;
        Owned = Pack is not null && userId is not null && await Entitlements.OwnsAsync(userId, Pack.Slug, CancellationToken.None);
    }
}
