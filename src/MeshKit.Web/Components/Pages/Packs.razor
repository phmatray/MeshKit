@page "/packs"
@inject ICatalogService Catalog

<PageTitle>Packs — MeshKit</PageTitle>
<Seo Title="All 3D model packs" Description="Every MeshKit pack: themed sets of game-ready 3D models with PBR textures, in GLB, FBX, OBJ and USDZ." Path="packs" />

<h1 class="mb-8 text-3xl font-bold">All packs</h1>

@if (Catalog.Sellable.Count == 0)
{
    <p class="text-ink/60">Nothing for sale yet — the first pack is probably still being generated.</p>
}
else
{
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var pack in Catalog.Sellable)
        {
            <PackCard Pack="pack" />
        }
    </div>

    <aside class="mt-12 rounded-2xl border border-ink/10 bg-white p-6 sm:flex sm:items-center sm:justify-between sm:gap-6" aria-labelledby="notify-cta">
        <div>
            <h2 id="notify-cta" class="text-lg font-semibold">New packs land regularly</h2>
            <p class="mt-1 text-sm text-ink/70">Get one email per release — and nothing else. Stop any time with one click.</p>
        </div>
        <AuthorizeView>
            <Authorized><a href="account" class="mt-4 inline-block shrink-0 rounded-full bg-ink px-5 py-2 text-sm font-semibold text-cream hover:bg-ink/85 sm:mt-0">Email me about new packs</a></Authorized>
            <NotAuthorized><a href="account/register?returnUrl=%2Faccount" class="mt-4 inline-block shrink-0 rounded-full bg-ink px-5 py-2 text-sm font-semibold text-cream hover:bg-ink/85 sm:mt-0">Create an account to get notified</a></NotAuthorized>
        </AuthorizeView>
    </aside>
}
