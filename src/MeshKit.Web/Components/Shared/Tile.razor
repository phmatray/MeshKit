@* One number with its label, for the dashboard. *@
<div class="rounded-2xl border border-ink/10 bg-white p-4">
    <p class="text-xs font-semibold uppercase tracking-wide text-ink/50">@Label</p>
    <p class="mt-1 text-2xl font-bold tabular-nums">@Value</p>
    @if (Hint is not null)
    {
        <p class="mt-0.5 text-xs text-ink/60">@Hint</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter, EditorRequired] public required string Value { get; set; }
    [Parameter] public string? Hint { get; set; }
}
