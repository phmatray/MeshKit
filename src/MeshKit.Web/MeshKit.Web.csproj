<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>meshkit-web-7c1f3a2e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <!-- Direct pin to lift the transitive SQLitePCLRaw pulled in by the EF Core SQLite provider
         past the native SQLite CVE fixed in 2.1.12+. Keep it even if it looks unused: removing a
         direct reference does not remove a transitive package, it just lets it fall back. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Stripe.net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MeshKit.Core/MeshKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MeshKit.Web.Tests" />
  </ItemGroup>

</Project>
