{
  "name": "meshkit-web-assets",
  "private": true,
  "description": "Builds the Tailwind stylesheet and copies the model-viewer bundle into wwwroot.",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --minify",
    "build:js": "node -e \"require('fs').mkdirSync('wwwroot/js',{recursive:true});require('fs').copyFileSync('node_modules/@google/model-viewer/dist/model-viewer.min.js','wwwroot/js/model-viewer.min.js')\"",
    "watch": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --watch"
  },
  "dependencies": {
    "@google/model-viewer": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
